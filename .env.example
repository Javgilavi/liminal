# Copy to .env (already gitignored), or edit the local .env created for you.
# This file is read by `liminal episode` and `liminal plan`; do not source it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Per-run model request cap, including validation repairs. No automatic upgrade.
LIMINAL_MAX_MODEL_CALLS=3
LIMINAL_MAX_OUTPUT_TOKENS=1500
LIMINAL_MODEL_TIMEOUT_S=30
