@@ -1539,8 +1539,17 @@ class HumanTeleopSession:
         token = self._tick_token
         tick_index = -1
         unix_at_read = 0.0
+        # Absolute deadlines, not `period - elapsed`: a relative sleep loses
+        # every tick's sleep overshoot and every overrun for good, so the loop
+        # ran 0.4% slow idle and 1.7% slow with camera streams open (sim,
+        # 2026-10-17), and the recorder freezes fps from this rate and refuses
+        # a take past 0.5%. With deadlines a long tick is paid back by shorter
+        # sleeps after it. Debt is capped at one period so a stall never turns
+        # into a burst of back-to-back ticks.
+        next_deadline = time.perf_counter()
         while not self._stop_flag.is_set():
             tick_start = time.perf_counter()
+            next_deadline += period
             tick_index += 1
             sampling = token is not None and (tick_index % sample_every) == 0
             try:
@@ -1886,7 +1895,9 @@ class HumanTeleopSession:
                     break
                 time.sleep(0.05)
                 continue
-            elapsed = time.perf_counter() - tick_start
-            sleep_for = period - elapsed
+            now = time.perf_counter()
+            if next_deadline < now - period:
+                next_deadline = now - period
+            sleep_for = next_deadline - now
             if sleep_for > 0:
                 time.sleep(sleep_for)
